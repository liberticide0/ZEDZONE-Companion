<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ZEDZONE.Companion</AssemblyName>
    <Version>0.4.12</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UpdateFixture)' == 'true'">
    <DefineConstants>$(DefineConstants);UPDATE_FIXTURE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LocalBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);LOCAL_BUILD</DefineConstants>
  </PropertyGroup>
</Project>
